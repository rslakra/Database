# Copy to .env and fill in your values:
#   cp .env.sample .env
#
# Get a free Hugging Face token at:
#   https://huggingface.co/settings/tokens

# Required for QA chain + faster Hugging Face Hub downloads
HF_TOKEN=hf_your_token_here

# Optional — disables Chroma anonymous telemetry (recommended for local demos)
ANONYMIZED_TELEMETRY=False
