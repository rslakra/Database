# PostgreSQL (external host)
POSTGRES_HOST=host
POSTGRES_PORT=5432
POSTGRES_DB=name
POSTGRES_USER=postgre_staging
POSTGRES_PASSWORD=password
# disable | allow | prefer | require | verify-ca | verify-full
POSTGRES_SSLMODE=prefer

# Databricks (optional - leave empty to disable the "databricks" target)
DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=
DATABRICKS_SCHEMA=

# Table queried by GET /query-data
SAMPLE_TABLE=sample_table
